# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains environment variables for the multi-agent system.
# Copy this file to .env and replace the placeholder values with actual API keys.

# -----------------------------------------------------------------------------
# LLM API
# -----------------------------------------------------------------------------
MODEL_SAFETY=gpt-4o
MODEL_CONVERSATION=gpt-4o-mini
MODEL_DECISION=gpt-4o-mini
MODEL_ANALYZER=gpt-4o-mini
MODEL_DOCUMENT=gpt-4o-mini
MODEL_CREDIT_MEMO=gpt-4o-mini
MODEL_GUARDRAIL=gpt-4o-mini
MODEL_BCTC_EXTRACTION=gpt-4o-mini
MODEL_PROPOSAL_EXTRACTION=gpt-4o-mini
MODEL_CIC_S10A_EXTRACTION=gpt-4o-mini
MODEL_CIC_R21_EXTRACTION=gpt-4o-mini

MODEL_ECONOMY=gpt-4o-mini
MODEL_PREMIUM=gpt-4o-mini

OPENAI_API_KEY=
OPENAI_API_BASE=

# -----------------------------------------------------------------------------
# LLM TIMEOUT AND RETRIES
# -----------------------------------------------------------------------------
LLM_TIMEOUT_SECONDS=60
LLM_ANALYZE_TIMEOUT_SECONDS=180
# Retries on 429/5xx. The SDK backs off and honours Retry-After. This is the
# safety net behind LLM_REQUESTS_PER_MINUTE, not the primary control.
LLM_CLIENT_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# LLM RATE LIMIT
# -----------------------------------------------------------------------------
# Hard ceiling on LLM requests per minute, shared by every client in the
# process. Set it BELOW your provider's real quota — one full credit memo run
# costs about 10 calls (4 parallel specialists + risk + memo + judge + BCTC
# extraction per statement + one per document the keyword pass is unsure about),
# so at 9/minute a full run spends roughly a minute being throttled. That is the
# cost of never getting a 429.
# Raise it if your quota is higher; lower it if the quota is shared with other
# people or jobs, since this limiter cannot see their traffic.
LLM_REQUESTS_PER_MINUTE=9

# -----------------------------------------------------------------------------
# WEB SEARCH
# -----------------------------------------------------------------------------
TAVILY_API_KEY=
ENABLE_WEB_SEARCH_ENRICHMENT=true
TAVILY_MAX_RESULTS=3
TAVILY_INCLUDE_DOMAINS=dangkykinhdoanh.gov.vn,masothue.com,thuvienphapluat.vn
WEB_SEARCH_QUERY_SAMPLE_CHAR_LIMIT=4000
WEB_SEARCH_CONTEXT_CHAR_LIMIT=6000


# -----------------------------------------------------------------------------
# Notebook workflow feature flags (read by notebooks/src/underwriting/config.py)
# -----------------------------------------------------------------------------
RUN_SAFETY_GUARDRAILS=false
RUN_WEB_SEARCH=false

# Max concurrent LLM requests (analysis agents run in parallel up to this).
# Set to your provider's rate limit. The memo workflow runs 4 analysis
# agents concurrently, so 4 uses the full parallel block.
LLM_MAX_CONCURRENCY=4


# -----------------------------------------------------------------------------
# OCR
# -----------------------------------------------------------------------------
# How many pages OCR at once. Tesseract runs out-of-process so this scales
# almost linearly: a 43-page statement went 96s -> 22s at 8 workers. Each
# worker holds a 300dpi page (~25 MB) plus its own tesseract process, so raise
# it with memory in mind. Empty/0 = min(8, CPU count).
OCR_MAX_WORKERS=

# Correct pages rotated a quarter turn. OFF because the detector splits by
# angle, measured on testing/samples: every 90° verdict was right (4/4) but
# every 180° verdict was wrong (4/4) and flipped an upright page into noise.
# Off therefore trades away the 90° repair to stop the 180° damage — pages
# 29-31 and 33 of BCTC_VVS_2024.pdf are the pages it costs. Turn on for a scan
# set that is genuinely sideways. Costs ~2.2s per 43 pages once parallel.
OCR_AUTO_ROTATE=0
