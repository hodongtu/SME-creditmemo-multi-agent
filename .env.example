# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy to .env and fill in the values. See README.md, "Configuration (.env)".

# -----------------------------------------------------------------------------
# MODELS — three roles, one variable each
# -----------------------------------------------------------------------------
# build_llm() raises at startup naming the variable if one is unset, so a
# missing model is caught before any call is made rather than mid-run.
MODEL_DOCUMENT=gpt-4o-mini     # document classification (LLM fallback)
MODEL_ANALYZER=gpt-4o-mini     # the specialist agents
MODEL_ECONOMY=gpt-4o-mini      # most structured-extraction passes
MODEL_PREMIUM=gpt-4o           # BCTC extraction — the pass whose output every
                               # financial figure is computed from

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_API_BASE=

# -----------------------------------------------------------------------------
# LLM TIMEOUT AND RETRIES
# -----------------------------------------------------------------------------
LLM_TIMEOUT_SECONDS=60
# The report is the longest single call, so it gets its own budget.
LLM_ANALYZE_TIMEOUT_SECONDS=180

# Completion-token ceiling. MUST stay under the ceiling of every model in use:
# going over is a 400 that stops the run, not a quiet trim. Run
# testing/probe_max_tokens.py to read each model's real ceiling — they differ
# eightfold (gpt-4o-mini 16,384, gpt-5.4-mini 128,000).
LLM_MAX_TOKENS=16000
# The ledger pass writes the whole record rather than a few labels, so it needs
# more room than the shared value can offer: 6 sheets of 340 rows measured
# 21,600-29,100 tokens. Only usable because that pass runs on a model with a
# 128,000 ceiling.
LLM_LEDGER_MAX_TOKENS=32000

# Retries on 429/5xx. The SDK backs off and honours Retry-After — with no
# rate limiter in front of it, this is the only thing standing between a
# burst of extractions and a 429.
LLM_CLIENT_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# OCR — all optional; values below are the defaults the code applies
# -----------------------------------------------------------------------------
TESSERACT_CMD=tesseract
OCR_LANG=vie+eng
OCR_DPI=300
OCR_PSM=6
OCR_OEM=3
OCR_CACHE_DIR=                 # empty = do not cache OCR results
OCR_TIMEOUT_SECONDS=           # per page; empty = no limit

# How many pages OCR at once. Tesseract runs out-of-process so this scales
# almost linearly: a 43-page statement went 96s -> 22s at 8 workers. Each
# worker holds a 300dpi page (~25 MB) plus its own tesseract process, so raise
# it with memory in mind. Empty/0 = min(8, CPU count).
OCR_MAX_WORKERS=

# Image preprocessing before Tesseract.
OCR_PREPROCESS=0
OCR_DESKEW=1
OCR_DENOISE=0
OCR_BINARIZE=0
OCR_LAYOUT=1
OCR_DELINE=1
OCR_UPSCALE=1.0

# Correct pages rotated a quarter turn. OFF because the detector splits by
# angle, measured on the sample set: every 90° verdict was right (4/4) but
# every 180° verdict was wrong (4/4) and flipped an upright page into noise.
# Off therefore trades away the 90° repair to stop the 180° damage. Turn on
# for a scan set that is genuinely sideways. Costs ~2.2s per 43 pages.
OCR_AUTO_ROTATE=0
